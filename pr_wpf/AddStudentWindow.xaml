<Window x:Class="pr_wpf.AddStudentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pr_wpf"
        mc:Ignorable="d"
        Title="Добавление студентов" Height="450" Width="800">

	<StackPanel Margin="20">
		<TextBlock Text="Имя:"/>
		<TextBox x:Name="NameBox" Margin="0,0,0,10"/>

		<TextBlock Text="Возраст:"/>
		<TextBox x:Name="AgeBox" Margin="0,0,0,10"/>

		<TextBlock Text="Группа:"/>
		<TextBox x:Name="GroupBox" Margin="0,0,0,10"/>

		<TextBlock Text="Балл:"/>
		<TextBox x:Name="GradeBox" Margin="0,0,0,10"/>

		<TextBlock Text="E-mail:"/>
		<TextBox x:Name="EmailBox" Margin="0,0,0,15"/>

		<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
			<Button Content="Добавить" Width="100" Margin="5" Click="Add_Click"/>
			<Button Content="Отмена"   Width="100" Margin="5" Click="Cancel_Click"/>
		</StackPanel>
	</StackPanel>
</Window>