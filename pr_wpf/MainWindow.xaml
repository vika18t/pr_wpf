<Window x:Class="pr_wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pr_wpf"
        mc:Ignorable="d"
        Title="Учёт студентов" Height="450" Width="800">
	<Grid Margin="15">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<TextBlock Text="Учёт студентов" FontSize="27" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10" Foreground="RoyalBlue"/>
		<DataGrid x:Name="StudGrid" Grid.Row="1" 
                  AutoGenerateColumns="True" 
                  IsReadOnly="True" 
                  SelectionMode="Single" 
                  Margin="0,0,0,10"
                  RowHeight="30"
                  ColumnWidth="*"/>

		<StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Center">
			<Button Content="Добавить" Width="120"  Height="35"  Margin="5" Click="AddButton_Click" Background="Blue"  Foreground="White" FontWeight="Bold"/>
			<Button Content="Удалить"   Width="120" Height="35"  Margin="5" Click="DeleteButton_Click" Background="Red" Foreground="White" FontWeight="Bold"/>
			<Button Content="Сохранить" Width="120" Height="35"  Margin="5" Click="SaveButton_Click" Background="Green" Foreground="White" FontWeight="Bold"/>
			<Button Content="Загрузить" Width="120" Height="35"   Margin="5" Click="LoadButton_Click" Background="Gray" Foreground="White" FontWeight="Bold"/>
		</StackPanel>
	</Grid>
</Window>